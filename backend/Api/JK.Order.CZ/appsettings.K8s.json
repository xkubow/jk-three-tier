{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=172.27.76.33;Port=30432;Database=jk_order;Username=postgres;Password=change-me-strong-password"
  },
  "Database": {
    "RunMigrationsOnStartup": false
  },
  "Cors": {
    "PolicyName": "DefaultCorsPolicy",
    "AllowedOrigins": [ "http://localhost:8080", "http://localhost:8095" ],
    "AllowedMethods": [ "*" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": false
  },
  "AllowedHosts": "*",
  "GrpcClientConfiguration": {
    "UseSecureSslChannel": false
  },
  "Platform": {
    "MarketCode": "CZ",
    "ServiceCode": "JK.Order.CZ"
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://otel-collector.observability:4317"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Formatting.Compact"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": ".\\..\\..\\..\\Logs\\JK.Order.CZ.Server.log",
          "OutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}]:[{Source}]:[{SourceContext}] - {Message}{NewLine}{ExceptionDetail}",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
