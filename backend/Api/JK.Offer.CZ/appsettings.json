{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=172.27.76.33;Port=30432;Database=jk_offer;Username=postgres;Password=change-me-strong-password"
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Cors": {
    "PolicyName": "DefaultCorsPolicy",
    "AllowedOrigins": [ "http://localhost:8080", "http://localhost:8095" ],
    "AllowedMethods": [ "*" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": false
  },
  "AllowedHosts": "*",
  "ConfigurationProvider": {
    "ServerUrl": "https://localhost:7001"
  },
  "GrpcClientConfiguration": {
    "UseSecureSslChannel": false
  },
  "Platform": {
    "MarketCode": "CZ",
    "ServiceCode": "JK.Offer.CZ"
  },
  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://otel-collector.observability:4317"
  },
  "LongRunningTasks": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxDegreeOfParallelism": 5,
    "LockTimeoutMinutes": 10,
    "RetryBaseDelaySeconds": 60,
    "MaxRetryDelaySeconds": 900
  },
  "FakeExternalOfferStore": {
    "DefaultOfferCount": 10000,
    "StoreOfferCounts": {
      "StoreA": 10000
    }
  }
